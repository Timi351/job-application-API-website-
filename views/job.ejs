<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <% if (jobs.length === 0) { %>

    <div>
        <h2>No jobs available</h2>
        <p>There are currently no jobs posted.</p>
    </div>

<% } else { %>

    <% jobs.forEach(job => { %>

        <div>
            <h2><%= job.title %> <span><%= job.role %></span></h2>
            <p><%= job.description %></p>
        </div>

    <% }) %>

<% } %>
    
</body>
</html>