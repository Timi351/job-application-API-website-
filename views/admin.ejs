<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>

    <title>Admin Dashboard</title>
  </head>

  <body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-white border-b">
      <div
        class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center"
      >
        <h1 class="text-xl font-bold text-blue-600">JobHub Admin</h1>

        <a href="/" class="text-gray-600 hover:text-blue-600"> Back to Home </a>
      </div>
    </header>

    <!-- Main -->
    <main class="max-w-3xl mx-auto px-6 py-10">
      <div class="bg-white rounded-xl shadow-sm p-8">
        <h2 class="text-2xl font-bold mb-2">Post a New Job</h2>

        <p class="text-gray-500 mb-8">
          Add the details of the job you want to advertise.
        </p>

        <!-- Job Form -->
        <form action="/jobs" method="POST" class="space-y-5">
          <!-- Job Title -->
          <div>
            <label for="title" class="block text-gray-700 font-semibold mb-2">
              Job Title
            </label>
            <input
              type="text"
              id="title"
              name="title"
              placeholder="Enter job title"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>
          <div>
            <label for="title" class="block text-gray-700 font-semibold mb-2">
              Job Role
            </label>
            <input
              type="text"
              id="role"
              name="role"
              placeholder="Enter job role"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>
          <div>
            <label for="title" class="block text-gray-700 font-semibold mb-2">
              Job Description
            </label>
            <input
              type="text"
              id="description"
              placeholder="Enter job description"
              name="description"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>
          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700"
          >
            Post Job
          </button>
        </form>
      </div>
    </main>
  </body>
</html>
