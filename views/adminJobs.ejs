
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <title>Available Jobs</title>
</head>

<body class="min-h-screen bg-gray-100 text-gray-800 p-6">

    <% if (jobs.length === 0) { %>

        <div class="max-w-xl mx-auto mt-20 bg-white p-10 rounded-xl shadow-md text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">
                No jobs available
            </h2>

            <p class="text-gray-500">
                There are currently no jobs posted.
            </p>
        </div>

    <% } else { %>

        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="jobs-container">

            <% jobs.forEach(job => { %>

                <div class="bg-white p-6 rounded-xl shadow-md border border-gray-200 hover:shadow-lg transition duration-300">

                    <h2 class="text-xl font-bold text-gray-900 mb-2">
                        <%= job.title %>
                        <span class="text-blue-600 text-base font-medium">
                            <%= job.role %>
                        </span>
                    </h2>

                    <p class="text-gray-600 leading-7 mb-6">
                        <%= job.description %>
                    </p>

                    <div class="flex items-center gap-3 border-t border-gray-100 pt-4">

                           <button
    data-id="<%= job.id %>"
    onclick="deleteJob(this.dataset.id)"
    class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition"
    type="button">
    Delete Job
</button>
   <button
    data-id="<%= job.id %>"
    onclick="editJob(this.dataset.id)"
    class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition"
    type="button">
    Edit Job
</button>
                        

                    </div>
</div>
                </div>

            <% }) %>
            

        </div>

    <% } %>

    <script>
        
    async function deleteJob(id) {
        const response = await fetch(`/admin/jobs/${id}`, {
            method: "DELETE"
        });

        if (!response.ok) {
            throw new Error("Failed to delete job");
        }
        else{
            window.location.reload();
        }


    }

    async function editJob(id){
         const response = await fetch(`/admin/jobs/${id}`, {
            method: "PUT"
        });

        if (!response.ok) {
            throw new Error("Failed to Edit job");
        }
        else{
            window.location.reload();
        }
        

    }

    

    </script>

    
</body>
</html>

