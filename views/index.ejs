<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://cdn.tailwindcss.com"></script>

    <title>JobHub | Find Your Next Opportunity</title>
</head>

<body class="bg-gray-50 text-gray-900">

    <!-- Navigation -->
    <header>
        <nav class="bg-white border-b shadow-sm">
            <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

                <!-- Logo -->
                <a href="/" class="text-2xl font-bold text-blue-600">
                    JobHub
                </a>

                <!-- Navigation Links -->
                <ul class="flex items-center gap-6">
                    <li>
                        <a href="/" class="text-gray-700 hover:text-blue-600">
                            Home
                        </a>
                    </li>

                    <li>
                        <a href="/jobs" class="text-gray-700 hover:text-blue-600">
                            Jobs
                        </a>
                    </li>

                    <li>
                        <a href="/apply" class="text-gray-700 hover:text-blue-600">
                            My Applications
                        </a>
                    </li>

                    <li>
                        <a
                            href="/admin"
                            class="bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700"
                        >
                            Employer
                        </a>
                    </li>
                </ul>

            </div>
        </nav>
    </header>


    <!-- Hero Section -->
    <main>

        <section class="max-w-6xl mx-auto px-6 py-20">

            <div class="max-w-3xl mx-auto text-center">

                <p class="text-blue-600 font-semibold mb-3">
                    FIND YOUR NEXT OPPORTUNITY
                </p>

                <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
                    Find a job that moves your career forward.
                </h1>

                <p class="text-lg text-gray-600 mb-8">
                    Discover job opportunities from companies looking for
                    talented people like you. Browse available positions and
                    submit your application in just a few steps.
                </p>

                <!-- Main Actions -->
                <div class="flex justify-center gap-4 flex-wrap">

                    <a
                        href="/jobs"
                        class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700"
                    >
                        Browse Jobs
                    </a>

                    <a
                        href="/apply"
                        class="border border-gray-300 bg-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-100"
                    >
                        My Applications
                    </a>

                </div>

            </div>

        </section>


        <!-- Features -->
        <section class="bg-white border-y">

            <div class="max-w-6xl mx-auto px-6 py-16">

                <div class="text-center mb-10">

                    <h2 class="text-3xl font-bold">
                        Everything you need to find your next role
                    </h2>

                    <p class="text-gray-600 mt-3">
                        A simple way to discover and apply for opportunities.
                    </p>

                </div>


                <div class="grid md:grid-cols-3 gap-6">

                    <!-- Feature 1 -->
                    <div class="border rounded-xl p-6">

                        <div class="text-3xl mb-4">
                            🔎
                        </div>

                        <h3 class="text-xl font-semibold mb-2">
                            Find Jobs
                        </h3>

                        <p class="text-gray-600">
                            Browse available jobs and find opportunities
                            that match your skills and interests.
                        </p>

                    </div>


                    <!-- Feature 2 -->
                    <div class="border rounded-xl p-6">

                        <div class="text-3xl mb-4">
                            📝
                        </div>

                        <h3 class="text-xl font-semibold mb-2">
                            Apply Easily
                        </h3>

                        <p class="text-gray-600">
                            Submit your application and provide the information
                            employers need to review your profile.
                        </p>

                    </div>


                    <!-- Feature 3 -->
                    <div class="border rounded-xl p-6">

                        <div class="text-3xl mb-4">
                            📊
                        </div>

                        <h3 class="text-xl font-semibold mb-2">
                            Track Applications
                        </h3>

                        <p class="text-gray-600">
                            Keep track of the jobs you've applied for and
                            monitor your application status.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- Employer Section -->
        <section class="max-w-6xl mx-auto px-6 py-16">

            <div class="bg-gray-900 text-white rounded-2xl p-10 flex flex-col md:flex-row items-center justify-between gap-6">

                <div>

                    <h2 class="text-3xl font-bold mb-3">
                        Looking for talented people?
                    </h2>

                    <p class="text-gray-300">
                        Companies can post job opportunities and manage
                        applications from one place.
                    </p>

                </div>

                <a
                    href="/admin"
                    class="bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold hover:bg-gray-200 whitespace-nowrap"
                >
                    Employer Dashboard
                </a>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="bg-white border-t">

        <div class="max-w-6xl mx-auto px-6 py-6 text-center text-gray-500">

            <p>
                © 2026 JobHub. All rights reserved.
            </p>

        </div>

    </footer>

</body>
</html>

